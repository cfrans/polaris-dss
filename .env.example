# Zabbix — aponte para a instância existente do ambiente, ou para a do profile `zabbix` do Compose
# Endpoint JSON-RPC completo, incluindo /api_jsonrpc.php
ZABBIX_URL=http://localhost:8080/api_jsonrpc.php
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix

# Banco de auditoria do Polaris
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME_AUDIT=polaris_audit

# Porta publicada pelo container do banco. Altere se a 5432 já estiver ocupada na máquina.
POLARIS_DB_PORT=5432

# API
API_HOST=0.0.0.0
API_PORT=8000

# Token exigido no header X-Polaris-Token do webhook do Zabbix
POLARIS_WEBHOOK_TOKEN=troque_este_token

# Endpoints de simulação e diagnóstico. Mantenha false durante a coleta de dados.
POLARIS_DEBUG=false

# Fatores de confiança dependentes do histórico de auditoria (F3 e F4).
# Desligue durante a coleta oficial para que todas as rodadas enfrentem condições idênticas.
POLARIS_CONFIDENCE_HISTORY=true

# Host alvo da remediação — precisa de systemd (VM ou container LXC de sistema; Docker não serve)
TARGET_SSH_HOST=
TARGET_SSH_USER=polaris
# Caminho, no host, da chave privada dedicada ao Polaris. Só ela é montada no container.
# Gere com: ssh-keygen -t ed25519 -N "" -f secrets/polaris_ed25519 -C "polaris-dss"
TARGET_SSH_KEY_PATH=./secrets/polaris_ed25519

# Porta publicada pela API
POLARIS_API_PORT=8000
