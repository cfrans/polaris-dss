# Conexões com Zabbix e alvo SSH: o assistente /configuracao.html preenche, testa e salva com
# cifra. As variáveis abaixo são opcionais; deixe em branco para configurar pelo navegador.

# Zabbix — endpoint JSON-RPC completo, incluindo /api_jsonrpc.php (pacotes Apache/Nginx usam
# /zabbix/api_jsonrpc.php). No profile `zabbix` do Compose: http://zabbix-web:8080/api_jsonrpc.php
ZABBIX_URL=
ZABBIX_USER=
ZABBIX_PASSWORD=
# Alternativa a usuário e senha: token de API criado em Users > API tokens.
ZABBIX_TOKEN=
# Nome técnico, no Zabbix, do host que monitora o próprio servidor Polaris (opcional).
# Alimenta o indicador "Servidor Polaris" do cabeçalho; também pode ser salvo pelo assistente.
POLARIS_ZABBIX_HOST=

# Banco de auditoria do Polaris. Troque a senha antes da primeira subida.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME_AUDIT=polaris_audit

# Porta publicada pelo container do banco. Altere se a 5432 já estiver ocupada na máquina.
# DB_PORT acima precisa acompanhar este valor: é a porta que as ferramentas rodadas no host usam
# para alcançar o banco. Dentro do container, o Compose sobrescreve com a porta interna.
POLARIS_DB_PORT=5432

# API
API_HOST=0.0.0.0
API_PORT=8000

# Token exigido no header X-Polaris-Token do webhook do Zabbix. O assistente gera um valor.
# Sem token configurado, o webhook recusa todos os eventos.
POLARIS_WEBHOOK_TOKEN=

# Endpoints de simulação e diagnóstico. Mantenha false durante a coleta de dados.
POLARIS_DEBUG=false

# Fatores de confiança dependentes do histórico de auditoria (F3 e F4).
# Desligue durante a coleta oficial para que todas as rodadas enfrentem condições idênticas.
POLARIS_CONFIDENCE_HISTORY=true

# Intervalo do laço que reconsulta o Zabbix por eventos não entregues pelo webhook.
# Zero desliga o laço.
POLARIS_POLLING_SEGUNDOS=30

# Host alvo da remediação — precisa de systemd (VM ou container LXC de sistema; Docker não serve)
TARGET_SSH_HOST=
TARGET_SSH_USER=polaris
# Somente com compose.ssh-env.yml: caminho, no host, da chave privada dedicada ao Polaris.
# O assistente dispensa este arquivo: gera a chave e a guarda cifrada no cofre.
# Gere com: ssh-keygen -t ed25519 -N "" -f secrets/polaris_ed25519 -C "polaris-dss"
TARGET_SSH_KEY_PATH=./secrets/polaris_ed25519

# Porta publicada pela API
POLARIS_API_PORT=8000

# Acesso ao navegador por outro computador da rede.
# false (padrão): HTTP só no endereço local; use HTTPS ou o túnel SSH impresso pelo servidor.
# true: cada navegador precisa de um código de pareamento gerado no servidor
# (python -m src.engine.pairing). HTTP continua sem criptografia: use só em laboratório isolado.
POLARIS_PAREAMENTO_HTTP=false

# Nível de log da aplicação: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Configuração guiada cifrada. O Compose fornece estes caminhos; mantenha a chave separada.
# Inicialize o acesso uma vez: docker compose exec polaris-api python -m src.engine.setup_vault
POLARIS_SETUP_DIR=
POLARIS_SETUP_KEY_FILE=
