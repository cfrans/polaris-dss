{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Polaris DSS — Base de Conhecimento",
  "type": "object",
  "required": ["versao_kb", "regras"],
  "additionalProperties": false,
  "properties": {
    "versao_kb": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "regras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nome", "condicao", "diagnostico", "remediacao", "confianca_base"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R\\d{3}$" },
          "nome": { "type": "string", "minLength": 3 },
          "habilitada": { "type": "boolean", "default": true },
          "severidade_minima": {
            "type": ["string", "null"],
            "enum": ["baixa", "media", "alta", "critica", null]
          },
          "referencia": { "type": ["string", "null"] },
          "condicao": {
            "type": "object",
            "required": ["tipo_alerta"],
            "additionalProperties": false,
            "anyOf": [
              { "required": ["regex_log"] },
              { "required": ["limiar_uso_pct"] }
            ],
            "properties": {
              "tipo_alerta": { "type": "string", "minLength": 3 },
              "regex_log": { "type": ["string", "null"] },
              "limiar_uso_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "metrica": { "type": ["string", "null"] },
              "operador": { "type": "string", "enum": [">", ">=", "<", "<=", "=="] },
              "parametros": {
                "type": "object",
                "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,128}$" }
              },
              "processos_alvo_permitidos": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }
              }
            }
          },
          "diagnostico": { "type": "string", "minLength": 40 },
          "remediacao": {
            "type": "object",
            "required": ["comando", "rollback", "timeout_segundos"],
            "additionalProperties": false,
            "properties": {
              "comando": { "type": "string", "minLength": 1 },
              "rollback": { "type": "string", "minLength": 1 },
              "timeout_segundos": { "type": "integer", "minimum": 1, "maximum": 600 },
              "script": { "type": ["string", "null"] },
              "verificador": { "type": ["string", "null"] },
              "requer_sudo": { "type": "boolean", "default": true },
              "destrutiva": { "type": "boolean", "default": false }
            }
          },
          "confianca_base": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
